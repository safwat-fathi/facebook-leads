# Copy to .env (server) or .env.local (local dev) and fill in. Never commit the real file, and never put secrets in this one.

# Public URL of the app, https and no trailing slash. Used for the cross-site request check, so it must match what the browser shows.
# Local dev: http://localhost:3000
APP_ORIGIN=https://leads.example.com
# The same host without https://, for Caddy (docker-compose.yml only).
APP_DOMAIN=leads.example.com

# Login. Run `pnpm run gen-key` (or `docker compose run --rm app node scripts/gen-key.mjs`): it prints the API key ONCE
# and these two values. The server stores only the hash.
APP_API_KEY_HASH=
SESSION_SECRET=

# Services the search actions use. Leave empty to disable the matching action.
APIFY_TOKEN=
OPENROUTER_API_KEY=
AGENT_MODEL=anthropic/claude-haiku-5.5

# Spending limits (USD). No single job may exceed MAX_JOB_USD; all jobs together may not exceed DAILY_BUDGET_USD in any 24 hours.
MAX_JOB_USD=3
DAILY_BUDGET_USD=10

# Where the database lives. Docker sets /data; locally the default is ./data
# DATA_DIR=./data
