# Copy to .env (server) or .env.local (local dev) and fill in. Never commit the real file, and never put secrets in this one.

# Public URL of the app, https and no trailing slash. Used for the cross-site request check, so it must match what the browser shows.
# Local dev: http://localhost:3000
APP_ORIGIN=https://fbleads.tijaratk.com

# Login. Run `pnpm run gen-key`: it prints the API key ONCE
# and these two values. The server stores only the hash.
APP_API_KEY_HASH=
SESSION_SECRET=

# Services the search actions use. Leave empty to disable the matching action.
APIFY_TOKEN=
OPENROUTER_API_KEY=
AGENT_MODEL=anthropic/claude-haiku-5.5
DRAFT_MODEL=

# Outreach email through Brevo. Leave BREVO_API_KEY empty to disable sending. The sender must be verified in Brevo (Senders & IP).
# Contacting businesses is regulated in Egypt (Law 151/2020): you are responsible for having the right to send.
BREVO_API_KEY=
OUTREACH_FROM_EMAIL=hello@tijaratk.com
OUTREACH_FROM_NAME=Tijaratk
OUTREACH_DAILY_CAP=20

# Spending limits (USD). No single job may exceed MAX_JOB_USD; all jobs together may not exceed DAILY_BUDGET_USD in any 24 hours.
MAX_JOB_USD=1
DAILY_BUDGET_USD=2

# Where the database lives. Default is ./data
# DATA_DIR=./data

